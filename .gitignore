.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# go-task fingerprint cache
.task/

# Editors and OS cruft
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local development notes
CLAUDE.md
