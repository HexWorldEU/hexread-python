# Build output
dist/
build/
*.egg-info/

# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/
.python-version

# Resolver output. These are libraries, not applications: dependency ranges are the contract,
# so no lock file is committed and every `uv sync` / `uv run` writes one that stays local.
uv.lock

